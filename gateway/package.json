{
  "name": "openwa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWA gateway worker — open-wa/wa-automate engine + internal HTTP API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prisma:sync": "node -e \"require('fs').copyFileSync('../prisma/schema.prisma','prisma/schema.prisma')\"",
    "prisma:generate": "npm run prisma:sync && prisma generate --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@open-wa/wa-automate": "^4.74.0",
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
