# OpenWA gateway — environment (generic placeholders only; gitleaks must pass)

# URL of the internal web service (Coolify private network).
WEB_INTERNAL_URL=http://openwa-web:3000

# Shared Bearer secret for the internal A<->B HTTP API (set in Coolify).
INTERNAL_GATEWAY_SECRET=

# Shared Postgres (pgvector) — same DB the web service migrates.
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Persistent volume where open-wa stores per-session auth tokens.
SESSIONS_DIR=/app/sessions

# HTTP port for the internal API / container healthcheck.
PORT=8080

# Chromium for open-wa/puppeteer (set in the Docker image).
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
