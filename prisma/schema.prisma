// This is your Prisma schema file for OpenWA
// Fase 1 models: Tenant, User, UserTenant, WaSession, Contact, Conversation, Message, AiConfig, AuditLog
// Fase 2 models (vector): KnowledgeDoc, KnowledgeChunk, Correction — commented out

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GlobalRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum TenantRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum WaSessionStatus {
  QR
  CONNECTED
  BANNED
  OFFLINE
}

enum OptInStatus {
  IN
  OUT
  UNKNOWN
}

enum ConversationMode {
  AUTO
  COPILOT
  MANUAL
}

enum ConversationStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED
  DRAFT
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageSource {
  WA
  API
  CAMPAIGN
}

enum AiProviderType {
  BEDROCK
  OPENAI
}

enum OutboundMode {
  TEXT
  TEMPLATE
  INTENT
}

enum OutboundStatus {
  PENDING
  SENDING
  DONE
  FAILED
  CANCELED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  DONE
  CANCELED
}

// ─── Core Tenant ─────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  settings  Json?        // TenantSettings (src/lib/settings/schema.ts) — merged over recommendedDefaults
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  userTenants   UserTenant[]
  waSessions    WaSession[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  aiConfigs     AiConfig[]
  auditLogs     AuditLog[]
  apiKeys      ApiKey[]
  templates    Template[]
  campaigns    Campaign[]
  outboundJobs OutboundJob[]
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String
  role           GlobalRole @default(VIEWER)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  totpSecret     String?    // encrypted with AES-256-GCM
  createdAt      DateTime   @default(now())

  userTenants          UserTenant[]
  assignedConversations Conversation[]
  auditLogs            AuditLog[]
}

model UserTenant {
  id       String     @id @default(cuid())
  userId   String
  tenantId String
  role     TenantRole @default(VIEWER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// ─── WhatsApp Sessions ───────────────────────────────────────────────────────

model WaSession {
  id             String          @id @default(cuid())
  tenantId       String
  phoneLabel     String
  status         WaSessionStatus @default(OFFLINE)
  sessionDataRef String?         // encrypted reference to session file path
  settings       Json?           // TenantSettings shape — config del numero (per-bot)
  lastSeenAt     DateTime?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  campaigns    Campaign[]
  outboundJobs OutboundJob[]
  aiConfig      AiConfig?
  apiKeys       ApiKey[]

  @@index([tenantId])
  @@index([status])
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id             String      @id @default(cuid())
  tenantId       String
  waId           String      // WhatsApp ID (suffix-stripped; @lid or phone) — stable matching key
  name           String?     // resolved display name (pushName)
  phone          String?     // resolved real phone number (e.g. "393478435299"), no suffix
  profileSummary String?     // LLM-generated summary of contact preferences
  optInStatus    OptInStatus @default(UNKNOWN)
  tags           String[]    @default([])
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  outboundJobs OutboundJob[]

  @@unique([tenantId, waId])
  @@index([tenantId])
}

// ─── Conversations ───────────────────────────────────────────────────────────

model Conversation {
  id            String             @id @default(cuid())
  tenantId      String
  contactId     String
  sessionId     String
  mode          ConversationMode   @default(MANUAL)
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  assignedUserId String?
  replyingAt    DateTime? // claim atomico anti-race per generateAndDeliverReply (FIX 2)
  deletedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contact  Contact   @relation(fields: [contactId], references: [id])
  session  WaSession @relation(fields: [sessionId], references: [id])
  assignee User?     @relation(fields: [assignedUserId], references: [id])
  messages Message[]
  outboundJobs OutboundJob[]

  @@index([tenantId])
  @@index([status])
  @@index([lastMessageAt])
  // Hot paths: worker/reply contano i Message per sessione/contatto via la
  // relazione Conversation (join su questi campi) → senza indice = seq scan.
  @@index([sessionId])
  @@index([contactId])
  @@index([tenantId, lastMessageAt])
}

// ─── Messages ────────────────────────────────────────────────────────────────

model Message {
  id             String          @id @default(cuid())
  conversationId String
  tenantId       String
  direction      MessageDirection
  body           String?
  mediaRef       String?
  status         MessageStatus
  aiGenerated    Boolean         @default(false)
  source         MessageSource   @default(WA)
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  @@index([conversationId])
  @@index([tenantId])
  @@index([status])
}

// ─── AI Config ───────────────────────────────────────────────────────────────

model AiConfig {
  id                 String         @id @default(cuid())
  tenantId           String
  sessionId          String?        @unique
  provider           AiProviderType @default(BEDROCK)
  modelId            String         @default("eu.anthropic.claude-sonnet-4-5-20250929-v1:0")
  systemPrompt       String?
  temperature        Float          @default(0.7)
  autoReplyEnabled   Boolean        @default(false)
  businessHours      Json?          // { timezone, days, startHour, endHour }
  updatedAt          DateTime       @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  session WaSession? @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Outbound queue (Fase 3) ────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  sessionId  String?
  hashedKey  String    @unique          // sha256(plaintext) hex
  prefix     String                      // primi 12 char del plaintext, per display
  label      String
  scopes     String[]  @default([])      // es. ["messages:send"]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  session WaSession? @relation(fields: [sessionId], references: [id])

  @@index([tenantId])
}

model Template {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  body      String                       // testo con {{placeholder}}
  variables String[]  @default([])        // nomi placeholder estratti
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]

  // NOTA: NIENTE @@unique([tenantId, name]) — sarebbe totale e bloccherebbe la
  // ricreazione dopo soft-delete. Sostituito da un indice unico PARZIALE
  // (Template_tenantId_name_active, WHERE deletedAt IS NULL) aggiunto a mano
  // nella migrazione SQL. La route templates cattura già P2002.
  @@index([tenantId])
}

model Campaign {
  id              String         @id @default(cuid())
  tenantId        String
  sessionId       String
  name            String
  mode            OutboundMode   @default(TEXT)
  body            String?                       // se TEXT
  templateId      String?                       // se TEMPLATE
  defaultVars     Json?                         // vars di campagna per il template
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  totalRecipients Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  session  WaSession     @relation(fields: [sessionId], references: [id])
  template Template?     @relation(fields: [templateId], references: [id])
  jobs     OutboundJob[]

  @@index([tenantId])
  @@index([status])
}

model OutboundJob {
  id             String         @id @default(cuid())
  tenantId       String
  sessionId      String
  contactId      String
  conversationId String?
  campaignId     String?
  mode           OutboundMode
  payload        Json                          // OutboundPayload (lib/outbound/types.ts)
  source         MessageSource  @default(API)
  status         OutboundStatus @default(PENDING)
  scheduledAt    DateTime?                      // null = appena possibile
  attempts       Int            @default(0)
  maxAttempts    Int            @default(3)
  lastError      String?
  messageId      String?                        // Message creato all'invio
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sentAt         DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  session      WaSession     @relation(fields: [sessionId], references: [id])
  contact      Contact       @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])

  // FIX F: idempotenza dell'enqueue di campagna — un contatto non può essere
  // accodato due volte per la stessa campagna (ri-lanci sicuri). I job non di
  // campagna hanno campaignId NULL: in Postgres i NULL multipli non violano
  // un indice unico, quindi l'enqueue via API (campaignId assente) non è vincolato.
  @@unique([campaignId, contactId])
  @@index([status, scheduledAt])
  @@index([tenantId])
  @@index([sessionId, status])
  @@index([campaignId])
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}
